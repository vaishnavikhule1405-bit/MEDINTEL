# MEDINTEL AI Environment Configuration

# Application
APP_NAME=MEDINTEL AI
APP_VERSION=1.0.0
DEBUG=True
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database (PostgreSQL URL format, fallback to SQLite if PostgreSQL not connected)
DATABASE_URL=sqlite:///./medintel.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://medintel_user:password@localhost:5432/medintel_db

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Model Paths (Relative to repository root)
CLINICAL_MODEL_PATH=models/clinical_xgboost.pkl
CLINICAL_FEATURES_PATH=models/clinical_features.pkl
CLINICAL_CLASS_MAPPING_PATH=models/clinical_class_mapping.json
CLINICAL_SHAP_GLOBAL_PATH=models/clinical/clinical_global_shap_importance.csv

IMAGING_MODEL_PATH=models/imaging/custom_cnn_best.pth
IMAGING_METADATA_PATH=models/imaging/final_imaging_model_metadata.json

NLP_CONFIG_PATH=models/nlp/final_ner_config.json
NLP_METADATA_PATH=models/nlp/nlp_module_metadata.json
NLP_EMBEDDINGS_PATH=models/nlp/medical_text_embeddings.npy
NLP_STANDARDIZED_OUTPUT_PATH=results/nlp/standardized_nlp_output.jsonl
NLP_EXPLAINABILITY_PATH=results/nlp/nlp_explainability_examples.json

FUSION_METADATA_PATH=models/fusion/final_fusion_metadata.json
SYNTHETIC_CASES_PATH=results/fusion/synthetic_multimodal_cases.jsonl
FUSION_EXPLANATIONS_PATH=results/fusion/final_multimodal_explanations.jsonl

# Security & Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
